# Camp Riverbend — environment variables
# Copy this file to .env.local and fill in real values.

# ── Required for everything ────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# NextAuth (v5 reads AUTH_SECRET; NEXTAUTH_SECRET kept for clarity).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me
NEXTAUTH_SECRET=replace-me
NEXTAUTH_URL=http://localhost:3000

# Public site URL — used by Stripe checkout success/cancel and OG metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (Resend) ─────────────────────────────────────────
# When unset: order routes still work, but no emails are sent (logged to console).
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=abby@campriverbend.com
EMAIL_FROM="Camp Riverbend <noreply@campriverbend.com>"

# ── Stripe ─────────────────────────────────────────────────
# When unset: Stripe checkout returns 503; only Account Billing works.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Seed defaults ──────────────────────────────────────────
# Used by `npm run db:seed` when creating the initial super admin.
ADMIN_EMAIL=admin@campriverbend.com
ADMIN_PASSWORD=ChangeMeNow!2026

# ── Analytics (optional) ───────────────────────────────────
NEXT_PUBLIC_FATHOM_SITE_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
